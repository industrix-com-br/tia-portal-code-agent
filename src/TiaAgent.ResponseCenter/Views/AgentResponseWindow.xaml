<Window x:Class="TiaAgent.ResponseCenter.Views.AgentResponseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TiaAgent.ResponseCenter.Converters"
        xmlns:local="clr-namespace:TiaAgent.ResponseCenter"
        Title="TIA Agent"
        Width="700" Height="600"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <Window.Resources>
        <converters:StateToStatusConverter x:Key="StateToStatus" />
        <converters:StateToColorConverter x:Key="StateToColor" />
        <converters:StateToProgressVisibilityConverter x:Key="StateToProgress" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:BooleanInverterConverter x:Key="BoolInverter" />

        <!-- Minimalist button style -->
        <Style x:Key="MinimalButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="BorderBrush" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TIA Agent"
                               Foreground="#1A1A1A"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HeaderDisplay}"
                               Foreground="#666666"
                               FontSize="13"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Copy response button (top right) -->
                <Button Grid.Column="1"
                        Content="Copy response"
                        Command="{Binding CopyResponseCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,6"
                        FontSize="12"
                        Visibility="{Binding ShowCopyButton, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Row 1: Main content area -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Loading state -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True"
                             Width="40" Height="40"
                             Style="{StaticResource {x:Null}}"
                             Foreground="#0078D4">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Ellipse Width="40" Height="40" Stroke="#E5E5E5" StrokeThickness="4"/>
                                <Ellipse Width="40" Height="40" Stroke="#0078D4" StrokeThickness="4"
                                         StrokeDashArray="1.5 8.5"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="PART_Indicator" Angle="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     To="360" Duration="0:0:1"
                                                                     RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock Text="Analyzing code…"
                           FontSize="14"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
                <TextBlock Text="Waiting for Agent Code"
                           FontSize="12"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Response content -->
            <FlowDocumentScrollViewer x:Name="ResponseViewer"
                                       Grid.Row="0"
                                       Margin="16"
                                       Visibility="{Binding ShowResponse, Converter={StaticResource BoolToVis}}"
                                       VerticalScrollBarVisibility="Auto"
                                       HorizontalScrollBarVisibility="Disabled"
                                       BorderThickness="0" />

            <!-- Error display -->
            <StackPanel Grid.Row="0"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}"
                        MaxWidth="500">
                <TextBlock Text="The request could not be completed."
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="#1A1A1A"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <TextBlock Text="Agent Code did not return a valid response."
                           FontSize="13"
                           Foreground="#666666"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <!-- Technical details expander -->
                <Border BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Background="#FFFFFF">
                    <Expander x:Name="TechnicalDetailsExpander"
                              Padding="12,8"
                              Expanded="TechnicalDetailsExpander_Expanded"
                              Collapsed="TechnicalDetailsExpander_Collapsed">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DetailsToggleText"
                                           Text="View details"
                                           Foreground="#0078D4"
                                           FontSize="12"
                                           Cursor="Hand" />
                            </StackPanel>
                        </Expander.Header>
                        <TextBox Text="{Binding ErrorDetails.TechnicalDetails, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 MaxHeight="150"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#F8F8F8"
                                 BorderBrush="#E5E5E5"
                                 BorderThickness="1"
                                 Margin="0,8,0,0" />
                    </Expander>
                </Border>

                <!-- Correlation ID -->
                <TextBlock FontSize="11"
                           Foreground="#999999"
                           TextAlignment="Center"
                           Margin="0,12,0,0"
                           Visibility="{Binding ErrorDetails.CorrelationId, Converter={StaticResource StringToVis}}">
                    <Run Text="Correlation: " /><Run Text="{Binding ErrorDetails.CorrelationId, Mode=OneWay}" />
                </TextBlock>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0">
                    <Button Content="Try again"
                            Command="{Binding RetryCommand}"
                            Style="{StaticResource MinimalButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Close"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </StackPanel>

            <!-- Approval preview placeholder -->
            <Border Grid.Row="0"
                    Margin="24"
                    Visibility="{Binding ShowApproval, Converter={StaticResource BoolToVis}}"
                    BorderBrush="#FF8C00"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="#FFF8E1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="500">
                <StackPanel Margin="16">
                    <TextBlock Text="Approval Required"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#FF8C00"
                               Margin="0,0,0,8" />
                    <TextBlock Text="The AI agent is proposing changes that require your review."
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#666666"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Approval workflow will be available in a future update."
                               FontSize="12"
                               Foreground="#999999"
                               FontStyle="Italic" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2: Footer with text input -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <!-- Placeholder text -->
                    <TextBlock Text="Ask something about the selected code…"
                               Foreground="#999999"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding UserInput, Converter={StaticResource StringToVis}, ConverterParameter=Invert}"
                               x:Name="PlaceholderText" />

                    <!-- Text input -->
                    <TextBox x:Name="InputTextBox"
                             Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"
                             Padding="8,6"
                             VerticalContentAlignment="Center"
                             BorderBrush="#E5E5E5"
                             BorderThickness="1"
                             Background="#F5F5F5"
                             MaxHeight="100"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             IsEnabled="{Binding ShowTextInput}" />
                </Grid>

                <Button Grid.Column="1"
                        Content="Send"
                        Command="{Binding SendCommand}"
                        Style="{StaticResource MinimalButton}"
                        Margin="8,0,0,0"
                        Padding="16,8"
                        IsEnabled="{Binding ShowTextInput}" />
            </Grid>
        </Border>
    </Grid>
</Window>
