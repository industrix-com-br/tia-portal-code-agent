<Window x:Class="TiaAgent.ResponseCenter.Views.AgentResponseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TiaAgent.ResponseCenter.Converters"
        Title="TIA Agent"
        Width="700"
        Height="600"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="BorderBrush" Value="#E5E5E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F5F5F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#F5F5F5" />
                                <Setter Property="Foreground" Value="#CCCCCC" />
                                <Setter Property="BorderBrush" Value="#EEEEEE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E5E5E5"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TIA Agent"
                               Foreground="#1A1A1A"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HeaderDisplay}"
                               Foreground="#666666"
                               FontSize="13"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Copy response"
                        Command="{Binding CopyResponseCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,6"
                        FontSize="12"
                        Visibility="{Binding ResponseContent, Converter={StaticResource StringToVis}}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True"
                             Width="40"
                             Height="40"
                             Style="{StaticResource {x:Null}}"
                             Foreground="#0078D4">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Ellipse Width="40"
                                         Height="40"
                                         Stroke="#E5E5E5"
                                         StrokeThickness="4" />
                                <Ellipse Width="40"
                                         Height="40"
                                         Stroke="#0078D4"
                                         StrokeThickness="4"
                                         StrokeDashArray="1.5 8.5"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     To="360"
                                                                     Duration="0:0:1"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock Text="Analyzing code…"
                           FontSize="14"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
                <TextBlock Text="Waiting for Agent Code"
                           FontSize="12"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

            <FlowDocumentScrollViewer x:Name="ResponseViewer"
                                      Margin="16"
                                      Visibility="{Binding ShowResponse, Converter={StaticResource BoolToVis}}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      BorderThickness="0"
                                      IsToolBarVisible="False" />

            <StackPanel Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}"
                        MaxWidth="500">
                <TextBlock Text="The request could not be completed."
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="#1A1A1A"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding ErrorDetails.UserMessage}"
                           FontSize="13"
                           Foreground="#666666"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <Border BorderBrush="#E5E5E5"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="#FFFFFF"
                        Visibility="{Binding ErrorDetails.TechnicalDetails, Converter={StaticResource StringToVis}}">
                    <Expander x:Name="TechnicalDetailsExpander"
                              Padding="12,8"
                              Expanded="TechnicalDetailsExpander_Expanded"
                              Collapsed="TechnicalDetailsExpander_Collapsed">
                        <Expander.Header>
                            <TextBlock x:Name="DetailsToggleText"
                                       Text="View details"
                                       Foreground="#0078D4"
                                       FontSize="12"
                                       Cursor="Hand" />
                        </Expander.Header>
                        <TextBox Text="{Binding ErrorDetails.TechnicalDetails, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 MaxHeight="150"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#F8F8F8"
                                 BorderBrush="#E5E5E5"
                                 BorderThickness="1"
                                 Margin="0,8,0,0" />
                    </Expander>
                </Border>

                <TextBlock FontSize="11"
                           Foreground="#999999"
                           TextAlignment="Center"
                           Margin="0,12,0,0"
                           Visibility="{Binding ErrorDetails.CorrelationId, Converter={StaticResource StringToVis}}">
                    <Run Text="Correlation: " />
                    <Run Text="{Binding ErrorDetails.CorrelationId, Mode=OneWay}" />
                </TextBlock>

                <Button Content="Close"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0" />
            </StackPanel>

            <Border Margin="24"
                    Visibility="{Binding ShowApproval, Converter={StaticResource BoolToVis}}"
                    BorderBrush="#FF8C00"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="#FFF8E1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="500">
                <StackPanel Margin="16">
                    <TextBlock Text="Approval Required"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#FF8C00"
                               Margin="0,0,0,8" />
                    <TextBlock Text="The AI agent is proposing changes that require your review."
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#666666"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Approval workflow will be available in a future update."
                               FontSize="12"
                               Foreground="#999999"
                               FontStyle="Italic" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
