<Window x:Class="TiaAgent.ResponseCenter.Views.AgentResponseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TiaAgent.ResponseCenter.Converters"
        xmlns:local="clr-namespace:TiaAgent.ResponseCenter"
        xmlns:models="clr-namespace:TiaAgent.ResponseCenter.Models"
        Title="TIA Agent"
        Width="760"
        Height="640"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource Brush.ApplicationBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TiaAgent.ResponseCenter;component/UI/Resources/Colors.xaml" />
                <ResourceDictionary Source="/TiaAgent.ResponseCenter;component/UI/Resources/Typography.xaml" />
                <ResourceDictionary Source="/TiaAgent.ResponseCenter;component/UI/Resources/Controls.xaml" />
                <ResourceDictionary Source="/TiaAgent.ResponseCenter;component/UI/Resources/Markdown.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:StringToVisibilityConverter x:Key="StringToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Brush.ApplicationBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource Brush.HeaderBackground}"
                BorderBrush="{StaticResource Brush.TiaAccent}"
                BorderThickness="0,0,0,3">
            <Grid Margin="{StaticResource Spacing.Header}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderDisplay}"
                               FontFamily="{StaticResource FontFamily.Ui}"
                               FontSize="{StaticResource FontSize.WindowTitle}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.HeaderForeground}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                        <TextBlock Text="{Binding ProjectName, StringFormat='Project: {0}'}"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   Foreground="#D9FFFFFF"
                                   Margin="0,0,14,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ProjectName, Converter={StaticResource StringToVis}}" />
                        <TextBlock Text="{Binding PlcName, StringFormat='PLC: {0}'}"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   Foreground="#D9FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding PlcName, Converter={StaticResource StringToVis}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Copy response"
                            Command="{Binding CopyResponseCommand}"
                            Style="{StaticResource HeaderButton}"
                            Margin="0,0,6,0"
                            Visibility="{Binding ShowCopyButton, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Copy response" />
                    <Button Content="×"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource HeaderCloseButton}"
                            ToolTip="Close"
                            AutomationProperties.Name="Close window" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.PanelBackground}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="{StaticResource Spacing.Status}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0" IsIndeterminate="True" Margin="0,0,8,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource CompactProgressBar}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:AgentTaskState.Created}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Ellipse Grid.Column="1"
                         Style="{StaticResource StatusIndicatorStyle}"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="{StaticResource FontSize.Small}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.PrimaryText}" />
                    <TextBlock Text="{Binding ProgressMessage, StringFormat='  —  {0}'}"
                               FontSize="{StaticResource FontSize.Small}"
                               Foreground="{StaticResource Brush.SecondaryText}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ProgressMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="{x:Static local:Strings.ButtonCancel}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="{StaticResource Spacing.CompactButton}"
                            Margin="0,0,6,0"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{x:Static local:Strings.ButtonRetry}"
                            Command="{Binding RetryCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="{StaticResource Spacing.CompactButton}"
                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="{StaticResource Spacing.Window}"
                Background="{StaticResource Brush.ContentBackground}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius.Panel}">
            <Grid>
                <FlowDocumentScrollViewer x:Name="ResponseViewer"
                                          Style="{StaticResource MarkdownViewerStyle}"
                                          Visibility="{Binding ShowResponse, Converter={StaticResource BoolToVis}}" />

                <StackPanel Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:AgentTaskState.Created}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar IsIndeterminate="True"
                                 Style="{StaticResource CompactProgressBar}"
                                 Width="24"
                                 Height="24"
                                 HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static local:Strings.WaitingText}"
                               Margin="0,14,0,0"
                               FontSize="{StaticResource FontSize.SectionTitle}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.PrimaryText}"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding ProgressMessage}"
                               Margin="0,5,0,0"
                               FontSize="{StaticResource FontSize.Small}"
                               Foreground="{StaticResource Brush.SecondaryText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Margin="24" Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Brush.Error}" />
                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                MaxWidth="620"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Static local:Strings.ErrorTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSize.SectionTitle}"
                                   Foreground="{StaticResource Brush.PrimaryText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorDetails.UserMessage}"
                                   FontSize="{StaticResource FontSize.Body}"
                                   Foreground="{StaticResource Brush.SecondaryText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,12" />
                        <Expander x:Name="TechnicalDetailsExpander"
                                  Expanded="TechnicalDetailsExpander_Expanded"
                                  Collapsed="TechnicalDetailsExpander_Collapsed"
                                  Visibility="{Binding ErrorDetails.TechnicalDetails, Converter={StaticResource StringToVis}}">
                            <Expander.Header>
                                <TextBlock x:Name="DetailsToggleText"
                                           Text="{x:Static local:Strings.ViewDetails}"
                                           Foreground="{StaticResource Brush.Link}"
                                           FontSize="{StaticResource FontSize.Small}"
                                           FontWeight="SemiBold"
                                           Cursor="Hand" />
                            </Expander.Header>
                            <TextBox Text="{Binding ErrorDetails.TechnicalDetails, Mode=OneWay}"
                                     IsReadOnly="True"
                                     MaxHeight="180"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource TechnicalTextBox}" />
                        </Expander>
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   Foreground="{StaticResource Brush.DisabledText}"
                                   Visibility="{Binding ErrorDetails.CorrelationId, Converter={StaticResource StringToVis}}">
                            <Run Text="Correlation: " />
                            <Run Text="{Binding ErrorDetails.CorrelationId, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="{x:Static local:Strings.ButtonRetry}"
                                    Command="{Binding RetryCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{x:Static local:Strings.ButtonClose}"
                                    Command="{Binding CloseCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Margin="24" Visibility="{Binding ShowApproval, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Brush.Warning}" />
                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                MaxWidth="620"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Static local:Strings.ApprovalTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSize.SectionTitle}"
                                   Foreground="{StaticResource Brush.PrimaryText}" />
                        <TextBlock Text="{x:Static local:Strings.ApprovalDescription}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSize.Body}"
                                   Foreground="{StaticResource Brush.SecondaryText}" />
                        <TextBlock Text="Approval workflow will be available in a future update."
                                   Margin="0,8,0,0"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{StaticResource Brush.DisabledText}"
                                   FontStyle="Italic" />
                    </StackPanel>
                </Grid>

                <Border Margin="24"
                        Padding="14"
                        BorderBrush="{StaticResource Brush.SubtleBorder}"
                        BorderThickness="1"
                        Background="{StaticResource Brush.ApplicationBackground}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:AgentTaskState.Cancelled}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Request cancelled"
                                   FontSize="{StaticResource FontSize.SectionTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.PrimaryText}" />
                        <TextBlock Text="The Agent Code request was cancelled. You can close this window safely."
                                   Margin="0,5,0,0"
                                   FontSize="{StaticResource FontSize.Body}"
                                   Foreground="{StaticResource Brush.SecondaryText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
