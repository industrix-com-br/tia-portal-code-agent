<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:TiaAgent.ResponseCenter.Models">
    <Style x:Key="TiaFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Brush.TiaAccent}"
                               StrokeThickness="1"
                               StrokeDashArray="1 1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TiaButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.StandardButton}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TiaFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CornerRadius.Control}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.TiaAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.TiaAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledText}" />
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.ApplicationBackground}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.SubtleBorder}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource TiaButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Brush.ContentBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.HoverBackground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource TiaButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Brush.HeaderBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBackground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AssistantAccent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.AssistantAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource TiaButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderForeground}" />
        <Setter Property="BorderBrush" Value="#66808FA3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.CompactButton}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2CFFFFFF" />
                <Setter Property="BorderBrush" Value="#99FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeaderCloseButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{DynamicResource Brush.DisabledText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="{x:Static models:AgentTaskState.Submitting}"><Setter Property="Fill" Value="{DynamicResource Brush.AssistantAccent}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static models:AgentTaskState.Queued}"><Setter Property="Fill" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static models:AgentTaskState.Running}"><Setter Property="Fill" Value="{DynamicResource Brush.AssistantAccent}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static models:AgentTaskState.WaitingForApproval}"><Setter Property="Fill" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static models:AgentTaskState.Completed}"><Setter Property="Fill" Value="{DynamicResource Brush.Success}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static models:AgentTaskState.Failed}"><Setter Property="Fill" Value="{DynamicResource Brush.Error}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static models:AgentTaskState.Cancelled}"><Setter Property="Fill" Value="{DynamicResource Brush.DisabledText}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static models:AgentTaskState.Disconnected}"><Setter Property="Fill" Value="{DynamicResource Brush.Error}" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CompactProgressBar" TargetType="ProgressBar">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AssistantAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Width="16" Height="16">
                        <Ellipse Stroke="{DynamicResource Brush.SubtleBorder}" StrokeThickness="2" />
                        <Ellipse Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="2"
                                 StrokeDashArray="1.4 4.6"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform Angle="0" /></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             To="360"
                                                             Duration="0:0:1.2"
                                                             RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TechnicalTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Monospace}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.CodeForeground}" />
        <Setter Property="Background" Value="{DynamicResource Brush.CodeBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CodeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.SelectionBackground}" />
    </Style>
</ResourceDictionary>
